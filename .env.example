# Copy to .env (gitignored) and adjust.

# Local development: DEBUG=true needs no SECRET_KEY and allows localhost + the Android emulator (10.0.2.2).
DEBUG=true
# Production: required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Comma-separated hostnames, e.g. api.ezrabiblenetwork.com
ALLOWED_HOSTS=
# Full origins for the dashboard login form over HTTPS, e.g. https://api.ezrabiblenetwork.com
CSRF_TRUSTED_ORIGINS=

# Dashboard "on air now" / "today's verse" use this zone.
TIME_ZONE=Asia/Kolkata

# Database: SQLite by default. Set these to use PostgreSQL (pip install "psycopg[binary]").
# POSTGRES_DB=ezra
# POSTGRES_USER=ezra
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Set true behind nginx / a hosting proxy so client IPs and HTTPS are detected.
BEHIND_PROXY=false
# Serve uploaded program images from Django. Turn off if nginx serves /media/.
SERVE_MEDIA=true

# Prayer-request spam guard: max posts per IP per window.
PRAYER_REQUEST_RATE=5
PRAYER_REQUEST_WINDOW_SECONDS=600
